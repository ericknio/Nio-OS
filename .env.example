# ==============================
# Nio-OS - Configuracao Local SQLite
# ==============================

# Banco local SQLite.
# Caminho relativo a pasta prisma/schema.prisma.
# Resultado: data/nio-os.db na raiz do sistema.
DATABASE_URL="file:../data/nio-os.db"

# Chave usada para assinar login/sessao.
# O preparar-local.bat cria uma chave automaticamente se ela estiver vazia.
AUTH_SECRET="troque-essa-chave-local-nio-os-por-uma-frase-grande"

# Porta padrao do sistema local.
PORT="3000"

# Ambiente
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"

NIO_OS_DATA_DIR=
NIO_OS_RUNTIME_DIR=
