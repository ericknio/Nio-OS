# ===================================================================
# Nio-OS Cloud Dashboard - Configuração de Variáveis de Ambiente
# ===================================================================

# 1. Conexão do Banco de Dados PostgreSQL (Ex: Neon DB, Supabase, RDS)
NIO_CLOUD_DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# 2. Segredo para Assinatura de Sessões JWT no Painel Cloud (Gere uma chave aleatória com 32+ caracteres)
JWT_SECRET="coloque-aqui-uma-chave-secreta-longa-e-aleatoria-para-o-painel"

# 3. Chave Privada Ed25519 (Conteúdo PEM completo para assinar licenças dos clientes)
# Se estiver inserindo na Vercel/Railway/Render, pode colar diretamente o bloco incluindo BEGIN/END:
# -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 4. Configurações de Produção
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"
