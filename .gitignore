# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js & Build Outputs
.next/
/out/
/dist/
desktop/dist/
/build/*
!/build/icon.png

# Release executables & large binaries (> 100MB blocked by GitHub)
/release/
/release-packages/
*.exe
*.blockmap
*.zip
*.tar.gz
*.dmg
*.deb
*.rpm

# Local database & Customer Data (LGPD compliance - NEVER commit real DBs)
/data/*.db
/data/*.db-wal
/data/*.db-shm
/data/*.sqlite
/data/*.sqlite-wal
/data/*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Trash, Backups & Logs
/lixo/
/backups/
/logs/
/storage/
/public/uploads/
/license/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & Secrets (LGPD & Security)
.env*
!.env.example
!.env*.example
*.pem
*.key
*.cert

# Misc & IDE
.DS_Store
*.tsbuildinfo
next-env.d.ts
/app/generated/prisma
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

